# CreatorYard の本番設定。/etc/creatoryard/creatoryard.env に置く。
#
# AUTH_SECRET が入るので、所有と権限を必ず絞る:
#   chown root:creatoryard /etc/creatoryard/creatoryard.env
#   chmod 640 /etc/creatoryard/creatoryard.env

# ---- 必須（ドメイン決定後に埋める） ----

# 公開オリジン。sitemap と OGP 画像の絶対 URL に使う。
# 末尾スラッシュなし。例: https://creatoryard.example
CY_SITE_ORIGIN=

# トークン署名鍵。32 文字以上のランダム文字列。生成例:
#   openssl rand -base64 48
# 未設定でも動く（store/ 隣に .auth-secret を自動生成する）が、
# 本番はファイルより env で持つ方が、バックアップと鍵の置き場を分けられる。
AUTH_SECRET=

# ---- 置き場 ----

# アカウント・Story・画像の実データ。バックアップ対象はここだけ。
CY_DATA_DIR=/var/lib/creatoryard/store

# ---- 待受と前段 ----

CY_API_PORT=8798

# nginx の X-Forwarded-For を信用する（流量制限が送信元ごとに効くために必要）。
# nginx を経由しない構成では 0 のままにする（ヘッダ偽装で制限をすり抜けられる）。
CY_TRUST_PROXY=1

# 開発用 CORS。本番は同一オリジン配下なので**設定しない**（空のまま）。
# CY_ALLOW_ORIGIN=
