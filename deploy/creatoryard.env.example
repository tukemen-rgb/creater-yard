# CreatorYard の本番設定。/etc/creatoryard/creatoryard.env に置く。
#
# AUTH_SECRET が入るので、所有と権限を必ず絞る:
#   chown root:creatoryard /etc/creatoryard/creatoryard.env
#   chmod 640 /etc/creatoryard/creatoryard.env

# ---- 必須（ドメイン決定後に埋める） ----

# 公開オリジン。sitemap と OGP 画像の絶対 URL に使う。
# 末尾スラッシュなし。例: https://creatoryard.example
CY_SITE_ORIGIN=

# トークン署名鍵。32 文字以上のランダム文字列。生成例:
#   openssl rand -base64 48
# 未設定でも動く（store/ 隣に .auth-secret を自動生成する）が、
# 本番はファイルより env で持つ方が、バックアップと鍵の置き場を分けられる。
AUTH_SECRET=

# ---- 置き場 ----

# アカウント・Story・画像の実データ。バックアップ対象はここだけ。
CY_DATA_DIR=/var/lib/creatoryard/store

# ---- バックアップ ----

# 書庫の置き場（deploy/backup.sh が取り、deploy/healthcheck.sh が見る）。
# BACKUP_DIR=/var/backups/creatoryard

# 死活確認が「最後のバックアップが古い」と鳴らすまでの時間。
# timer は毎日 1 回なので、既定の 36 時間以上で鳴る。1 回飛ばしでは鳴らず、
# 2 回続けて飛んだら鳴る幅。暦日ではなく時刻差なので時刻帯に依存しない。
# BACKUP_MAX_AGE_HOURS=36

# バックアップの確認そのものを切る。**バックアップを別の経路で取る構成の
# ときだけ** 0 にすること。置き場が無いだけで黙らせてはいけない
# （1 度も取れていないサーバーが、いちばん静かになってしまう）。
# BACKUP_CHECK=1

# ---- 待受と前段 ----

CY_API_PORT=8798

# 死活確認（deploy/healthcheck.sh）が叩く先。
# **GAMEYARD と同居していて web を 3001 に変えたなら、ここも必ず変える。**
# 既定は 3000 で、同居機では **3000 は GAMEYARD** なので、変え忘れると
# 死活確認は隣のサービスを見て「一覧の見出しがありません」と鳴り続ける
# （2026-08-17 の本番で実際に起きた）。ポートを変える場所は unit と
# nginx だけではなく、**ここを含めて 3 か所**ある。
# HEALTH_WEB=http://127.0.0.1:3001
# HEALTH_API=http://127.0.0.1:8798

# nginx の X-Forwarded-For を信用する（流量制限が送信元ごとに効くために必要）。
# nginx を経由しない構成では 0 のままにする（ヘッダ偽装で制限をすり抜けられる）。
CY_TRUST_PROXY=1

# 運営のハンドル（カンマ区切り）。通報の閲覧・状態更新に使う。
# GAMEYARD と同じく sidra_studio を想定（アカウントは通常の登録で作る）。
CY_ADMIN_HANDLES=sidra_studio

# 開発用 CORS。本番は同一オリジン配下なので**設定しない**（空のまま）。
# CY_ALLOW_ORIGIN=

# ---- メール（パスワード再設定に使う。未設定なら機能ごと「使えない」と明示） ----
#
# GAMEYARD と同じ mailer（server/lib/mailer.mjs）。SMTP を話せる業者なら
# どこでも使える。GAMEYARD 本番は Gmail SMTP（アプリパスワード）。

# none（既定・送らない） / smtp / sendmail
MAIL_TRANSPORT=none

# 差出人。表示名なしの素のアドレスで書く（形式検査がある）。
# 例: noreply@creatoryard.example
MAIL_FROM=

# MAIL_TRANSPORT=smtp のとき:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
