# Story の本文・一覧・書き手ページを動的に返す Next.js（SITE_MODE=server）。
#
# 固定ページ（トップ・ログイン等）は静的ファイルとして nginx が返すので、
# このプロセスに来るのは /story/ /creators/ /stories/ /tags/ だけ。
[Unit]
Description=CreatorYard dynamic pages (stories)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=creatoryard
Group=creatoryard
WorkingDirectory=/opt/creatoryard
ExecStart=/usr/bin/npx next start -H 127.0.0.1 -p 3000
EnvironmentFile=/etc/creatoryard/creatoryard.env
Environment=SITE_MODE=server
Environment=NODE_ENV=production
Restart=always
RestartSec=3
MemoryMax=768M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Story レコードを読むだけ。書き込みは API の仕事
ReadOnlyPaths=/var/lib/creatoryard
# server モードの成果物は .next-server（next.config.mjs の distDir）。
# .next は static ビルドの置き場で、このプロセスは触らない。
# ここを .next/cache のままにすると、ProtectSystem=strict の下で
# 実行時のキャッシュ書き込みが静かに失敗する。
# 起動前に .next-server/cache が存在し creatoryard の持ち物であること
# （GO-LIVE.md §3 の chown）。
ReadWritePaths=/opt/creatoryard/.next-server/cache
# AF_NETLINK は next start が起動時にネットワーク一覧を取得する
# （os.networkInterfaces）ために必要。無いと errno 97 で即落ちする
# （GAMEYARD で実測）。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
