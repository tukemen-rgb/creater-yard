# CreatorYard の nginx 設定例。GAMEYARD の型を縮約したもの。
#
# 要点:
#   1. 固定ページは静的ファイルで返し、無いものだけを動的サーバーへ回す
#      （/story/ /creators/ /stories/ /tags/ は Story が増えるたびに変わるので
#      server モードの Next.js が組み立てる）
#   2. /api/ と /sitemap-stories.xml は API プロセスへ
#   3. 画像は現状 /api/images/（同一オリジン）。検査済みバイト列＋nosniff。
#      GAMEYARD と同じ別オリジン配信に揃えるかはドメイン決定時の判断
#      （Issue #1 の判断材料）。揃える場合はこのファイルに画像用 server
#      ブロックを足し、API の配信部を移す
#
# <creatoryard.example> を本番ドメインに置き換える。証明書:
#   certbot certonly --nginx -d creatoryard.example

upstream creatoryard_api {
    server 127.0.0.1:8798;
    keepalive 8;
}

upstream creatoryard_web {
    server 127.0.0.1:3000;
    keepalive 8;
}

# ---- 訪問者の IP を取り戻す（Cloudflare のうしろに置くため）----
#
# **これが無いと、流量制限もログインのバックオフも全員で 1 枠を共有する。**
#
# 社長の決定はオレンジ雲のまま（2026-08-09）。オレンジ雲だと nginx から見た
# $remote_addr は **Cloudflare のエッジ IP** で、訪問者の IP ではない。
# 訪問元がエッジ数個に潰れるので、1 人が失敗を繰り返すと**全員が締め出される**。
# 訪問者の IP は Cloudflare が付ける CF-Connecting-IP にしか無い。
#
# **信じてよいのは、接続元が本当に Cloudflare のときだけ。**
# origin を直接叩いた相手は同じヘッダを自由に名乗れる。set_real_ip_from に
# 並べた相手から来たときだけ real_ip_header を信じる —— ここが抜けると、
# **誰でも他人の IP を騙れて、他人を締め出せる。**
#
# **IPv4 と IPv6 の両方を並べる。**`listen 443` と `listen [::]:443` の
# **両方で待ち受けている**ので、片方だけ並べると**その脚を通った訪問者だけ
# 取り戻せず、まとめて 1 枠**になる（IPv6 の範囲が無いまま origin に AAAA を
# 向けると実際にそうなる。2026-08-14 に④と gdp が独立に検出した）。
#
# 出典: https://www.cloudflare.com/ips-v4
#   取得日 2026-08-09 / **再確認 2026-08-14（15 範囲・変更なし）**
# 出典: https://www.cloudflare.com/ips-v6
#   **取得日 2026-08-14（7 範囲）**
#
# **Cloudflare は範囲を足すことがある。**入れっぱなしにせず、
# deploy/GO-LIVE.md の手順で取り直す（上の取得日を更新する）。
# **v4 と v6 の両方を取り直すこと。**片方だけ新しくすると、
# 古いほうの脚で同じ穴が開く。
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

server {
    # http2 は listen 行に付ける（nginx 1.24 系は `http2 on;` を知らない）
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name creatoryard.example;

    ssl_certificate     /etc/letsencrypt/live/creatoryard.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/creatoryard.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    # 静的書き出し（out/）の置き場。deploy 時に rsync で更新する
    root /var/www/creatoryard/static;
    index index.html;

    charset utf-8;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    # 外部読み込みは許さない。画像は自前（/api/images/）と data: のみ。
    # style の 'unsafe-inline' は Next.js が出すインラインスタイルのため
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;

    # ---- API ----
    location /api/ {
        # 画像アップロードの上限（3MB）＋余白。ここが小さいと投稿者には
        # 理由の分からない 413 だけが見える
        client_max_body_size 4m;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # 流量制限が送信元ごとに効くために必要。
        # API 側は CY_TRUST_PROXY=1 のときだけこれを見る。
        #
        # **上の set_real_ip_from と対で意味を持つ。**あちらで
        # $remote_addr が訪問者の IP に置き換わってから、ここでそれを渡す。
        # あちらが無いと、ここで渡るのは Cloudflare のエッジ IP。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://creatoryard_api;
    }

    # Story の sitemap は API が動的に返す。静的側に任せると 404 になり、
    # Story がクロールされない
    location = /sitemap-stories.xml {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_pass http://creatoryard_api;
    }

    # ---- 動的ページ（Story が増えるたびに変わるパス） ----
    location ~ ^/(story|stories|creators|tags)(/|$) {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://creatoryard_web;
    }

    # ---- 固定ページ（静的ファイル。無ければ動的サーバーへ） ----
    location / {
        try_files $uri $uri/index.html @dynamic;
    }
    location @dynamic {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://creatoryard_web;
    }
}

# HTTP は HTTPS へ
server {
    listen 80;
    listen [::]:80;
    server_name creatoryard.example;
    return 301 https://$host$request_uri;
}
