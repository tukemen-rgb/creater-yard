{
  "name": "creatoryard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SITE_MODE=server next dev",
    "build": "node scripts/build.mjs static",
    "build:server": "node scripts/build.mjs server",
    "start:server": "SITE_MODE=server next start",
    "lint": "eslint . && npm run typecheck && echo 'lint OK（ESLint + 型検査）'",
    "typecheck": "tsc --noEmit",
    "api": "node server/api.mjs",
    "test:server": "node --test server/test.mjs server/og.test.mjs server/interview.test.mjs server/write-ui.test.mjs server/auth-ui.test.mjs server/report-ui.test.mjs server/tally.test.mjs server/home-hero.test.mjs server/healthcheck.test.mjs",
    "verify": "node scripts/verify.mjs",
    "seed": "node scripts/demo-seed.mjs",
    "tally": "node scripts/tally.mjs"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.0",
    "nanoid": "3.3.18"
  }
}
